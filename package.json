  "version": "1.0.49",
  "description": "Aplicacion local de notas de intervencion y visitas tecnicas",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "check:js": "node tools/check-javascript.mjs",
